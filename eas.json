{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "ios": {
        "image": "sdk-54"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-54"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.ravelry.com/"
      }
    },
    "preview": {
      "channel": "preview",
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "image": "sdk-54"
      },
      "android": {
        "buildType": "apk",
        "image": "sdk-54"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://api.ravelry.com/"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "image": "sdk-54"
      },
      "android": {
        "image": "sdk-54"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://api.ravelry.com/"
      }
    },
    "simulator": {
      "environment": "development",
      "ios": {
        "simulator": true,
        "image": "sdk-54"
      },
      "android": {
        "image": "sdk-54"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://api.ravelry.com/"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "bundleIdentifier": "com.pelote.preview"
      }
    },
    "production": {
      "ios": {
        "bundleIdentifier": "com.pelote",
        "ascAppId": "6832739925"
      }
    }
  }
}

# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# Expo / EAS (used by app.config.ts — not validated in env.ts).
# For CI/EAS builds, set the same EAS_PROJECT_ID on the GitHub Actions runner
# and in the matching EAS environment (preview/production).
EXPO_ACCOUNT_OWNER=
EAS_PROJECT_ID=

# Ravelry API base URL
EXPO_PUBLIC_API_URL=https://api.ravelry.com/

# Ravelry OAuth2 (register at https://www.ravelry.com/pro/developer)
# Client ID is public. Client secret is injected via app.config `extra` at
# native/EAS build time — never commit it; never use EXPO_PUBLIC_ for it.
EXPO_PUBLIC_RAVELRY_CLIENT_ID=
RAVELRY_CLIENT_SECRET=

# Deep-link path appended to the app scheme (pelote://oauth)
EXPO_PUBLIC_RAVELRY_REDIRECT_PATH=oauth

# Optional associated domain for universal links
# EXPO_PUBLIC_ASSOCIATED_DOMAIN=https://pelote.app
